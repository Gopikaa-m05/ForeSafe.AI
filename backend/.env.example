# Backend Environment Variables
PROJECT_NAME="AI-Based Software Failure Prediction & Risk Analysis System"
API_V1_STR=/api
SECRET_KEY=production-secure-random-jwt-secret-key-38bf8c992a0e461b8f0
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database
# For SQLite (default):
DATABASE_URL=sqlite:///./software_failure.db
# For PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/software_failure_db

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://localhost:8000"]

# Google OAuth 2.0 Credentials (Replace with Google Cloud Console Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# SMTP Email Configuration (Optional - dev mode logs to console if empty)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAILS_FROM_EMAIL=noreply@softwarefailure.ai
EMAILS_FROM_NAME="Software Failure Prediction System"

# Frontend Application URL (for password reset links)
FRONTEND_URL=http://localhost:5173

# Groq LLM API Configuration (for ForeSafe AI Copilot)
GROQ_API_KEY=gsk_your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

